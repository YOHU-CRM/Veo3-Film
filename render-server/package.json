{
  "name": "yohu-render-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Máy dựng video (FFmpeg) cho YOHU – chạy trên máy cá nhân hoặc VPS, không tốn phí API.",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test test/e2e.test.ts test/image-scene.test.ts test/image-motion.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.0.2",
    "tsx": "^4.19.2",
    "@napi-rs/canvas": "^1.0.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
